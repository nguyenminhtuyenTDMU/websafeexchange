%% WebSafeExchange - DB physical schema va enum Drizzle/PostgreSQL
flowchart TD
    subgraph Enums["PostgreSQL Enums"]
        E1["trade_status: DRAFT, LISTED, JOINED, ARMED, FUNDED, COMPLETED, CANCELLED"]
        E2["log_type: TRADE_EVENT, SECURITY, SYSTEM"]
        E3["forum_post_type: SELL, BUY_REQUEST, DISCUSSION, QA, PINNED"]
    end

    subgraph Tables["Tables"]
        USERS["users\n- id varchar PK default gen_random_uuid()\n- wallet_address text NOT NULL UNIQUE\n- display_name text\n- created_at timestamp NOT NULL default now()"]
        TRADES["trades\n- id varchar PK default gen_random_uuid()\n- safe_address text NOT NULL\n- seller_address text NOT NULL\n- buyer_address text NULL\n- price_eth decimal(18,8) NOT NULL\n- deadline timestamp NOT NULL\n- onchain_trade_id text NULL\n- snapshot_nonce text NULL\n- status trade_status NOT NULL default DRAFT\n- created_at timestamp NOT NULL default now()\n- updated_at timestamp NOT NULL default now()"]
        LOGS["system_logs\n- id varchar PK default gen_random_uuid()\n- type log_type NOT NULL\n- message text NOT NULL\n- related_trade_id varchar FK trades.id NULL\n- metadata text NULL\n- created_at timestamp NOT NULL default now()"]
        POSTS["forum_posts\n- id varchar PK default gen_random_uuid()\n- type forum_post_type NOT NULL\n- title text NULL\n- question text NULL\n- content text NOT NULL default empty\n- tags text NULL JSON array string\n- author_alias text NOT NULL default An danh\n- author_address text NULL\n- contact text NULL\n- budget_eth decimal(18,8) NULL\n- is_pinned boolean NOT NULL default false\n- created_at timestamp NOT NULL default now()\n- updated_at timestamp NOT NULL default now()"]
        COMMENTS["forum_comments\n- id varchar PK default gen_random_uuid()\n- post_id varchar NOT NULL FK forum_posts.id ON DELETE CASCADE\n- parent_id varchar NULL self-reference logical\n- content text NOT NULL\n- author_alias text NOT NULL default An danh\n- author_address text NULL\n- anon_id text NULL\n- created_at timestamp NOT NULL default now()"]
    end

    E1 --> TRADES
    E2 --> LOGS
    E3 --> POSTS
    TRADES --> LOGS
    POSTS --> COMMENTS
    USERS -. logical wallet match .-> TRADES
    USERS -. logical author wallet .-> POSTS
    USERS -. logical author wallet .-> COMMENTS

    subgraph Access["Storage access patterns"]
        A1["getTrade(id)"]
        A2["getTradeBySafeAddress(active only)"]
        A3["getAllTrades(order by created_at desc)"]
        A4["getLogsByTrade(tradeId)"]
        A5["getForumPosts(type, pinned first)"]
        A6["getCommentsByPost(postId)"]
        A7["getUserByWalletOrCreate(walletAddress lowercase)"]
    end

    A1 --> TRADES
    A2 --> TRADES
    A3 --> TRADES
    A4 --> LOGS
    A5 --> POSTS
    A6 --> COMMENTS
    A7 --> USERS
