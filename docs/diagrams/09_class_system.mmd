%% WebSafeExchange - Class diagram tong quan
classDiagram
    direction LR

    class User {
        +string id
        +string walletAddress
        +string displayName
        +Date createdAt
    }

    class Trade {
        +string id
        +string safeAddress
        +string sellerAddress
        +string buyerAddress
        +decimal priceEth
        +Date deadline
        +string onchainTradeId
        +string snapshotNonce
        +TradeStatus status
        +Date createdAt
        +Date updatedAt
    }

    class SystemLog {
        +string id
        +LogType type
        +string message
        +string relatedTradeId
        +string metadata
        +Date createdAt
    }

    class ForumPost {
        +string id
        +ForumPostType type
        +string title
        +string question
        +string content
        +string tags
        +string authorAlias
        +string authorAddress
        +string contact
        +decimal budgetEth
        +boolean isPinned
        +Date createdAt
        +Date updatedAt
    }

    class ForumComment {
        +string id
        +string postId
        +string parentId
        +string content
        +string authorAlias
        +string authorAddress
        +string anonId
        +Date createdAt
    }

    class IStorage {
        <<interface>>
        +getUser(id)
        +getUserByWallet(walletAddress)
        +createUser(user)
        +getTrade(id)
        +getTradeBySafeAddress(safeAddress)
        +getAllTrades()
        +createTrade(trade)
        +updateTrade(id,data)
        +createLog(log)
        +getForumPosts(type)
        +createForumPost(post)
        +createComment(comment)
    }

    class DatabaseStorage {
        +getUser(id)
        +getUserByWallet(walletAddress)
        +createUser(user)
        +getTrade(id)
        +getTradesBySeller(sellerAddress)
        +getTradesByBuyer(buyerAddress)
        +getTradeBySafeAddress(safeAddress)
        +getAllTrades()
        +createTrade(trade)
        +updateTrade(id,data)
        +getSystemLogs()
        +getLogsByTrade(tradeId)
        +createLog(log)
        +getUserByWalletOrCreate(walletAddress)
        +updateUserDisplayName(walletAddress,displayName)
        +getForumPosts(type)
        +getForumPost(id)
        +createForumPost(post)
        +getCommentsByPost(postId)
        +createComment(comment)
        +seedForumPosts()
    }

    class EventBroadcaster {
        +initialize(httpServer)
        +broadcastNewTrade(trade)
        +broadcastTradeUpdate(tradeId,status,data)
        +sendToWallet(wallet,title,message,type)
        +sendToParticipants(title,message,type,seller,buyer)
    }

    class AuthService {
        +buildSignMessage(action,scope,timestamp)
        +verifySignature(signature,message,expectedAddress)
        +requireSignature(req,expectedAddress,action,scope)
        +validateEthAddress(address)
    }

    class SafeWatcher {
        +startSafeWatcher()
        +stopSafeWatcher()
        +onTradeArmed(safeAddress)
        +clearTradeNotifyCache(tradeId)
        -handleSafeExecution(safeAddress)
        -watchSafe(safeAddress)
        -unwatchSafe(safeAddress)
        -subscribeEscrowEvents()
    }

    class SafeExchangeEscrow {
        +mapping trades
        +mapping activeTradeBySafe
        +mapping buyerTrades
        +mapping sellerTrades
        +getTradeId(buyer,seller,safe)
        +armTrade(safe,buyer,amount,deadline)
        +deposit(id)
        +releaseFunds(id)
        +buyerRequestCancel(id)
        +sellerCancel(id)
        +cancelTimeout(id)
        +withdrawRefund(id)
    }

    class SafeSdk {
        +getSafeInfo(safeAddress)
        +isOwner(safeAddress,account)
        +swapOwner(safeAddress,oldOwner,newOwner)
    }

    IStorage <|.. DatabaseStorage
    DatabaseStorage ..> User
    DatabaseStorage ..> Trade
    DatabaseStorage ..> SystemLog
    DatabaseStorage ..> ForumPost
    DatabaseStorage ..> ForumComment
    Trade "1" --> "0..*" SystemLog : related logs
    ForumPost "1" --> "0..*" ForumComment : comments
    EventBroadcaster ..> Trade : broadcasts
    SafeWatcher ..> DatabaseStorage : reads active trades
    SafeWatcher ..> EventBroadcaster : sends updates
    SafeWatcher ..> SafeExchangeEscrow : watches events
    SafeExchangeEscrow ..> SafeSdk : Safe owner/nonce concept
    AuthService ..> User : wallet ownership
