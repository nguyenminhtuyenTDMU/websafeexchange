  FUNDED -> CANCELLED [label="  cancelBySeller\n  cancelByBuyer (ví bị đổi/thiếu tài sản)\n  cancelExpired\n  → hoàn tiền cho người mua"];
  OPEN -> CANCELLED [label="cancelBySeller\ncancelByBuyer\ncancelExpired  "];
