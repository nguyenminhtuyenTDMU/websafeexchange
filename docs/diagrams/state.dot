digraph state {
  rankdir=TB; nodesep=1.2; ranksep=0.7;
  fontname="Arial"; node [fontname="Arial", fontsize=12]; edge [fontname="Arial", fontsize=11];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", width=2];

  init [shape=circle, style=filled, fillcolor="#000000", label="", width=0.2];
  OPEN [label="OPEN\n(đã niêm yết)", fillcolor="#dbe9f7"];
  FUNDED [label="FUNDED\n(đã nạp tiền, ví đóng băng)", fillcolor="#fdf1d6"];
