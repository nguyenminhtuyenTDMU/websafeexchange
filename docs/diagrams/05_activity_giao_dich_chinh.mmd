%% WebSafeExchange - Activity diagram quy trinh giao dich chinh
flowchart TD
    Start([Bat dau])
    Connect["User ket noi vi Web3"]
    Role{Nguoi dung muon ban hay mua?}

    SellerInput["Seller nhap safeAddress, priceEth, deadline"]
    CheckSafe["Client lay thong tin Safe va kiem tra owner"]
    SignCreate["Seller ky create-trade"]
    CreateTrade["Server validate, tao trade LISTED, ghi log"]

    BuyerSearch["Buyer tim tradeId hoac safeAddress"]
    ReviewSafe["Buyer review thong tin Safe / gia / deadline"]
    SignJoin["Buyer ky join-trade"]
    JoinTrade["Server gan buyer, cap nhat JOINED, notify seller"]

    ArmOnchain["Seller goi armTrade tren escrow contract"]
    ArmBackend["Server luu onchainTradeId, snapshotNonce, ARMED"]
    Watcher["Safe watcher bat dau theo doi Safe"]

    Deposit["Buyer goi deposit kem ETH"]
    Funded["Server cap nhat FUNDED, notify seller"]
    TransferOwner["Seller swap owner Safe sang buyer"]
    Release["Seller hoac buyer goi releaseFunds"]
    Verify{Contract verify ownership thanh cong?}
    Complete["Server cap nhat COMPLETED, ghi log, broadcast"]
    End([Ket thuc thanh cong])

    CancelPath["Huy / timeout / suspicious"]
    Cancelled["Server cap nhat CANCELLED va broadcast"]
    EndCancel([Ket thuc huy])

    Start --> Connect --> Role
    Role -- Ban --> SellerInput --> CheckSafe --> SignCreate --> CreateTrade
    Role -- Mua --> BuyerSearch --> ReviewSafe --> SignJoin --> JoinTrade
    CreateTrade --> BuyerSearch
    JoinTrade --> ArmOnchain --> ArmBackend --> Watcher --> Deposit --> Funded --> TransferOwner --> Release --> Verify
    Verify -- Co --> Complete --> End
    Verify -- Khong --> CancelPath --> Cancelled --> EndCancel

    CreateTrade -. seller huy listing .-> CancelPath
    JoinTrade -. buyer rut / seller huy .-> CancelPath
    ArmBackend -. qua deadline hoac seller cancel .-> CancelPath
    Funded -. suspicious hoac timeout .-> CancelPath
