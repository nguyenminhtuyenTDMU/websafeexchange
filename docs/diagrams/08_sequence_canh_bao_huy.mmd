%% WebSafeExchange - Sequence diagram suspicious, cancel, timeout
sequenceDiagram
    autonumber
    actor Seller
    actor Buyer
    participant BuyUI as Buy Page
    participant SellUI as Sell Page
    participant API as Express API
    participant DB as PostgreSQL/Drizzle
    participant Escrow as SafeExchangeEscrow
    participant Safe as Gnosis Safe
    participant Watcher as Safe Watcher
    participant WS as EventBroadcaster

    Safe-->>Watcher: ExecutionSuccess(txHash)
    Watcher->>DB: getAllTrades()
    Watcher->>Safe: isOwner(buyer)
    Watcher->>Safe: isOwner(seller)
    alt Ownership transferred correctly
        Watcher->>WS: broadcastTradeUpdate(OWNERSHIP_TRANSFERRED)
        WS-->>BuyUI: trade_update
        Buyer->>BuyUI: Xac nhan giai ngan
        BuyUI->>Escrow: releaseFunds(onchainTradeId)
        Escrow->>Safe: verify buyer owner, seller not owner
        Escrow-->>Seller: transfer ETH
        BuyUI->>API: POST /api/trades/:id/complete
        API->>DB: updateTrade(COMPLETED)
    else Nonce tang nhung buyer chua la owner
        Watcher->>Safe: nonce()
        Watcher->>DB: createLog(SECURITY)
        Watcher->>WS: broadcastTradeUpdate(SUSPICIOUS_ACTIVITY)
        WS-->>BuyUI: Canh bao bat thuong
        Buyer->>BuyUI: Yeu cau hoan tien
        BuyUI->>Escrow: buyerRequestCancel(onchainTradeId)
        Escrow->>Safe: nonce()
        Escrow->>Safe: isOwner(buyer)
        Escrow-->>Buyer: refund ETH neu fundsHeld
        BuyUI->>API: POST /api/trades/:id/cancel
        API->>DB: updateTrade(CANCELLED)
        API->>WS: sendToParticipants
    end

    opt Seller huy truoc khi hoan tat
        Seller->>SellUI: Huy giao dich
        alt LISTED/JOINED
            SellUI->>API: POST /api/trades/:id/cancel
        else ARMED/FUNDED
            SellUI->>Escrow: sellerCancel(onchainTradeId)
            Escrow-->>Buyer: refund ETH neu fundsHeld
            SellUI->>API: POST /api/trades/:id/cancel
        end
        API->>DB: updateTrade(CANCELLED)
        API->>WS: broadcastTradeUpdate(CANCELLED)
    end

    opt Qua deadline
        Buyer->>BuyUI: Huy do het han
        BuyUI->>Escrow: cancelTimeout(onchainTradeId)
        Escrow-->>Buyer: refund ETH neu fundsHeld
        BuyUI->>API: POST /api/trades/:id/cancel
        API->>DB: updateTrade(CANCELLED)
    end
