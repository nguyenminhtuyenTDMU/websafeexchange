%% WebSafeExchange - Sequence diagram rieng cho Buyer
sequenceDiagram
    autonumber
    actor Buyer
    participant BuyUI as Buy Page
    participant Wallet as Web3 Wallet
    participant API as Express API
    participant Auth as Auth Service
    participant DB as PostgreSQL/Drizzle
    participant SafeApi as Safe Transaction API
    participant Escrow as Escrow Contract
    participant Safe as Gnosis Safe
    participant WS as WebSocket

    Buyer->>BuyUI: Ket noi vi va mo trang Mua Safe
    Buyer->>BuyUI: Nhap tradeId hoac safeAddress
    BuyUI->>API: GET /api/trades/search?q=...
    API->>DB: getTrade(query)
    alt Khong tim theo id va query la address
        API->>DB: getTradeBySafeAddress(query)
    end
    DB-->>API: trade LISTED
    API-->>BuyUI: thong tin trade

    Buyer->>BuyUI: Kiem tra minh bach Safe
    BuyUI->>API: GET /api/safe-info?address=safeAddress
    API->>SafeApi: GET /api/v1/safes/{safeAddress}
    SafeApi-->>API: owners, threshold, nonce, modules, guard
    API-->>BuyUI: Safe info

    Buyer->>BuyUI: Xac nhan tham gia
    BuyUI->>Wallet: Ky message join-trade
    Wallet-->>BuyUI: signature, signedMessage
    BuyUI->>API: POST /api/trades/:id/join
    API->>Auth: requireSignature(buyerAddress, join-trade, tradeId)
    Auth-->>API: hop le
    API->>DB: getTrade(id)
    DB-->>API: trade LISTED
    API->>API: validate buyer != seller
    API->>DB: updateTrade(buyerAddress,status=JOINED)
    API->>DB: createLog(TRADE_EVENT)
    API->>WS: broadcastTradeUpdate(JOINED)
    API->>WS: sendToWallet(seller)
    API-->>BuyUI: trade JOINED

    WS-->>BuyUI: trade_update ARMED khi seller kich hoat
    BuyUI->>API: GET /api/trades/:id
    API->>DB: getTrade(id)
    DB-->>API: trade ARMED + onchainTradeId
    API-->>BuyUI: trade ARMED

    Buyer->>BuyUI: Gui ky quy ETH
    BuyUI->>Escrow: deposit(onchainTradeId) + priceEth
    Escrow-->>BuyUI: tx receipt + TradeFunded
    BuyUI->>API: POST /api/trades/:id/deposit
    API->>DB: updateTrade(status=FUNDED)
    API->>DB: createLog(TRADE_EVENT)
    API->>WS: broadcastTradeUpdate(FUNDED)
    API->>WS: sendToWallet(seller)
    API-->>BuyUI: trade FUNDED

    alt Seller chuyen owner thanh cong
        WS-->>BuyUI: trade_update OWNERSHIP_TRANSFERRED
        Buyer->>BuyUI: Xac nhan va giai ngan
        BuyUI->>Escrow: releaseFunds(onchainTradeId)
        Escrow->>Safe: isOwner(buyer)
        Safe-->>Escrow: true
        Escrow->>Safe: isOwner(seller)
        Safe-->>Escrow: false
        Escrow-->>BuyUI: TradeCompleted
        BuyUI->>API: POST /api/trades/:id/complete
        API->>DB: updateTrade(status=COMPLETED)
        API->>WS: broadcastTradeUpdate(COMPLETED)
        API-->>BuyUI: trade COMPLETED
    else Safe co hoat dong bat thuong
        WS-->>BuyUI: trade_update SUSPICIOUS_ACTIVITY
        Buyer->>BuyUI: Yeu cau hoan tien
        BuyUI->>Escrow: buyerRequestCancel(onchainTradeId)
        Escrow->>Safe: nonce()
        Safe-->>Escrow: currentNonce
        Escrow->>Safe: isOwner(buyer)
        Safe-->>Escrow: false
        Escrow-->>Buyer: refund ETH
        BuyUI->>API: POST /api/trades/:id/cancel
        API->>DB: updateTrade(status=CANCELLED)
        API->>WS: broadcastTradeUpdate(CANCELLED)
        API-->>BuyUI: trade CANCELLED
    end

    opt Buyer rut hoac huy do deadline
        alt Trade moi JOINED
            BuyUI->>API: POST /api/trades/:id/cancel
        else Trade ARMED/FUNDED va qua deadline
            BuyUI->>Escrow: cancelTimeout(onchainTradeId)
            Escrow-->>Buyer: refund ETH neu fundsHeld
            BuyUI->>API: POST /api/trades/:id/cancel
        end
        API->>DB: updateTrade(status=CANCELLED)
        API->>WS: broadcastTradeUpdate(CANCELLED)
        API-->>BuyUI: trade CANCELLED
    end
