%% WebSafeExchange - Activity diagram cho huy giao dich va canh bao bat thuong
flowchart TD
    Start([Trade dang ARMED hoac FUNDED])
    Event{Su kien phat sinh}

    SellerCancel["Seller chon huy giao dich"]
    BuyerUnjoin["Buyer rut khi chua on-chain"]
    Timeout["Deadline da qua"]
    SafeExec["Safe phat sinh ExecutionSuccess"]

    WatchRead["Watcher doc isOwner(buyer), isOwner(seller), nonce"]
    OwnershipOK{Buyer la owner va seller khong con owner?}
    Suspicious{Nonce tang nhung buyer chua la owner?}

    NotifyOwnership["Broadcast OWNERSHIP_TRANSFERRED"]
    BuyerRelease["Buyer/Seller goi releaseFunds"]
    Complete["Cap nhat COMPLETED"]

    NotifySuspicious["Broadcast SUSPICIOUS_ACTIVITY va ghi SECURITY log"]
    BuyerCancel["Buyer goi buyerRequestCancel"]

    OnchainCancel{Can huy on-chain?}
    SellerCancelSC["Goi sellerCancel"]
    TimeoutSC["Goi cancelTimeout"]
    BackendCancel["POST /api/trades/:id/cancel"]
    Cancelled["Cap nhat CANCELLED, clear cache, notify participants"]
    Refund["Escrow hoan ETH neu fundsHeld"]
    End([Ket thuc])

    Start --> Event
    Event -- Seller cancel --> SellerCancel --> OnchainCancel
    Event -- Buyer rut truoc arm --> BuyerUnjoin --> BackendCancel
    Event -- Het deadline --> Timeout --> TimeoutSC --> BackendCancel
    Event -- Safe tx --> SafeExec --> WatchRead --> OwnershipOK

    OwnershipOK -- Co --> NotifyOwnership --> BuyerRelease --> Complete --> End
    OwnershipOK -- Khong --> Suspicious
    Suspicious -- Co --> NotifySuspicious --> BuyerCancel --> BackendCancel
    Suspicious -- Khong --> End

    OnchainCancel -- LISTED/JOINED --> BackendCancel
    OnchainCancel -- ARMED/FUNDED --> SellerCancelSC --> BackendCancel
    BackendCancel --> Cancelled --> Refund --> End
