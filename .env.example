DATABASE_URL=

# Escrow SC address sau khi deploy (Sepolia)
VITE_ESCROW_CONTRACT_ADDRESS=0xeF4b477e5f24Cd260215a0E966258D534227f07e

# Chain ID (11155111 = Sepolia, 1 = Mainnet)
CHAIN_ID=11155111

# RPC endpoints cho Safe Watcher (server-side)
# WSS bắt buộc để dùng event subscription (thay polling)
# Lấy miễn phí tại https://dashboard.alchemy.com hoặc https://infura.io
# VD: wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_WS_URL=

# HTTP RPC dùng để readContract (isOwner, nonce) khi có event
# VD: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_HTTP_URL=

# ─── Langflow Chatbot ────────────────────────────────────────────────────────
# URL của Langflow instance (local hoặc cloud)
# Local: http://localhost:7860
# Cloud: https://api.langflow.astra.datastax.com
LANGFLOW_API_URL=http://localhost:7860

# Flow ID của chatbot chính (copy từ Langflow URL: /flow/<FLOW_ID>)
LANGFLOW_FLOW_ID=

# Flow ID của alert flow (nonce drift notifications) — tuỳ chọn
LANGFLOW_ALERT_FLOW_ID=

# API key nếu dùng Langflow Cloud hoặc self-hosted có auth
LANGFLOW_API_KEY=
