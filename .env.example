DATABASE_URL=

# Escrow SC address sau khi deploy (Sepolia)
VITE_ESCROW_CONTRACT_ADDRESS=0x90ff66a4c895621fC011c7ef56Fc786FEC14d969

# Chain ID (11155111 = Sepolia, 1 = Mainnet)
CHAIN_ID=11155111

# RPC endpoints cho Safe Watcher (server-side)
# WSS bắt buộc để dùng event subscription (thay polling)
# Lấy miễn phí tại https://dashboard.alchemy.com hoặc https://infura.io
# VD: wss://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_WS_URL=

# HTTP RPC dùng để readContract (isOwner, nonce) khi có event
# VD: https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RPC_HTTP_URL=
