classDiagram
    direction LR

    class User {
        +UUID id
        +string walletAddress
        +string role
        +datetime createdAt
        +connectWallet() bool
        +getActiveTrades() List~Trade~
    }

    class Trade {
        +int id
        +UUID sellerId
        +UUID buyerId
        +string safeAddress
        +decimal escrowAmount
        +uint256 nonceSnapshot
        +string status
        +string txHashDeposit
        +string txHashRelease
        +datetime createdAt
        +datetime updatedAt
        +list() void
        +arm() void
        +deposit() void
        +release() void
        +cancel() void
    }

    class Evidence {
        +UUID id
        +int tradeId
        +string type
        +json payload
        +datetime detectedAt
    }

    class ChatSession {
        +UUID sessionId
        +UUID userId
        +datetime startedAt
        +datetime lastActive
        +addMessage(Message) void
        +getHistory() List~Message~
    }

    class Message {
        +UUID id
        +UUID sessionId
        +string role
        +string content
        +json toolCalls
        +datetime timestamp
    }

    class LangflowAgent {
        +string flowId
        +string systemPrompt
        +Memory memory
        +List~Tool~ tools
        +run(input, sessionId) Response
        +selectTool(intent) Tool
    }

    class Tool {
        <<interface>>
        +string name
        +string description
        +execute(params) Result
    }

    class EscrowStateReader {
        +getTradeStatus(id) Trade
        +readOnChain(id) dict
    }

    class SafeNonceChecker {
        +snapshotNonce(addr) uint256
        +getCurrentNonce(addr) uint256
        +detectDrift(tradeId) bool
    }

    class RAGRetriever {
        +string vectorStoreUrl
        +string embeddingModel
        +retrieve(query, k) List~Document~
    }

    class WalletConnector {
        +requestSignature(tx) string
        +getTxReceipt(hash) Receipt
    }

    class VectorStore {
        +string collectionName
        +upsert(docs) void
        +similaritySearch(q, k) List
    }

    class SmartContract {
        <<SafeExchangeEscrow.sol>>
        +mapping trades
        +armTrade(id, nonce)
        +deposit(id) payable
        +releaseFunds(id)
        +cancelTrade(id)
    }

    class SafeWatcher {
        +pollInterval int
        +watchList List
        +startPolling() void
        +onNonceDrift(cb) void
    }

    User "1" --> "*" Trade : owns/buys
    Trade "1" --> "*" Evidence : has
    User "1" --> "*" ChatSession : initiates
    ChatSession "1" --> "*" Message : contains
    ChatSession "1" --> "1" LangflowAgent : uses

    LangflowAgent "1" --> "*" Tool : orchestrates
    Tool <|.. EscrowStateReader
    Tool <|.. SafeNonceChecker
    Tool <|.. RAGRetriever
    Tool <|.. WalletConnector

    RAGRetriever --> VectorStore : queries
    EscrowStateReader --> SmartContract : reads
    EscrowStateReader --> Trade : syncs off-chain
    SafeNonceChecker --> SmartContract : reads
    SafeNonceChecker --> SafeWatcher : subscribes
    SafeWatcher --> Evidence : creates alerts
