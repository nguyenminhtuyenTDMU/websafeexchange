sequenceDiagram
    autonumber
    actor Buyer as Buyer
    participant UI as Chat UI
    participant LF as Langflow
    participant Agent as Agent Node
    participant Wallet as MetaMask<br/>(Wallet)
    participant API as SafeExchange API
    participant SC as SafeExchangeEscrow<br/>Contract

    Buyer->>UI: "Tôi muốn ký quỹ cho trade #42"
    UI->>LF: POST run (input, session_id)
    LF->>Agent: Xử lý intent = deposit

    Agent->>API: GET /trades/42
    API-->>Agent: {status, amount, buyer, seller}

    alt Trade chưa ARMED
        Agent-->>UI: "Trade chưa sẵn sàng<br/>(status=LISTED).<br/>Seller cần kích hoạt trước."
    else Trade đã ARMED
        Agent->>SC: call trades(42)<br/>// verify on-chain
        SC-->>Agent: {escrowAmount, status=ARMED}

        Agent-->>UI: "Trade hợp lệ.<br/>Bạn cần ký quỹ 0.5 ETH<br/>(+ ước tính gas ~0.002 ETH).<br/>Bấm Xác nhận để ký quỹ."
        UI-->>Buyer: Hiển thị button Xác nhận
        Buyer->>UI: Bấm Xác nhận

        UI->>Wallet: Yêu cầu signTransaction<br/>(deposit, 0.5 ETH)
        Wallet-->>Buyer: Popup xác nhận MetaMask
        Buyer->>Wallet: Ký giao dịch
        Wallet->>SC: sendTransaction deposit()<br/>{value: 0.5 ETH}
        SC-->>Wallet: txHash

        Wallet-->>UI: txHash
        UI->>LF: POST run ("đã gửi tx: 0x..")
        LF->>Agent: intent = confirm_tx

        Agent->>API: POST /trades/42/deposit-tx<br/>{txHash}
        API-->>Agent: {status: "PENDING"}

        loop Polling tối đa 60s
            Agent->>SC: getTransactionReceipt(txHash)
            SC-->>Agent: pending / confirmed
        end

        alt Transaction confirmed
            Agent->>API: PATCH /trades/42<br/>{status: "FUNDED"}
            API-->>Agent: OK
            Agent-->>UI: "Ký quỹ thành công!<br/>Trade #42 → FUNDED."
        else Transaction revert
            Agent-->>UI: "Giao dịch thất bại.<br/>Lý do: {reason}.<br/>Thử lại hoặc liên hệ hỗ trợ."
        end
    end
