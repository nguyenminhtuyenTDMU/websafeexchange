digraph UseCaseDiagram {
    rankdir=LR;
    fontname="Times New Roman";
    node [fontname="Times New Roman"];
    edge [fontname="Times New Roman", fontsize=10];
    labelloc="t";
    label="Sơ đồ Use Case Tổng quát – Chatbot Langflow cho SafeExchange";
    fontsize=14;

    node [shape=none, margin=0];
    Guest  [label=<<table border="0"><tr><td><font point-size="40">👤</font></td></tr><tr><td><b>Guest</b></td></tr></table>>];
    Buyer  [label=<<table border="0"><tr><td><font point-size="40">👤</font></td></tr><tr><td><b>Buyer</b></td></tr></table>>];
    Seller [label=<<table border="0"><tr><td><font point-size="40">👤</font></td></tr><tr><td><b>Seller</b></td></tr></table>>];

    LLM     [label=<<table border="0"><tr><td><font point-size="30">⚙</font></td></tr><tr><td><b>LLM Service</b><br/>(OpenAI / Ollama)</td></tr></table>>];
    SafeAPI [label=<<table border="0"><tr><td><font point-size="30">⚙</font></td></tr><tr><td><b>SafeExchange API</b><br/>(Express.js)</td></tr></table>>];
    Watcher [label=<<table border="0"><tr><td><font point-size="30">⚙</font></td></tr><tr><td><b>Safe Watcher</b><br/>Service</td></tr></table>>];
    Chain   [label=<<table border="0"><tr><td><font point-size="30">⚙</font></td></tr><tr><td><b>Ethereum Sepolia</b><br/>(Smart Contract)</td></tr></table>>];

    subgraph cluster_system {
        label="Hệ thống Chatbot Langflow";
        style=rounded;
        bgcolor="#F5F9FF";
        color="#2E75B6";
        penwidth=2;

        node [shape=ellipse, style=filled, fillcolor="#D5E8F0", color="#2E75B6"];

        UC01 [label="UC01\nTra cứu thông tin\nSafeExchange"];
        UC02 [label="UC02\nGiải thích quy trình\nký quỹ (Escrow)"];
        UC03 [label="UC03\nHướng dẫn kết nối ví\n(Wallet Connect)"];
        UC04 [label="UC04\nNiêm yết ví Safe\n(List trade)"];
        UC05 [label="UC05\nKích hoạt trade\n(Arm trade)"];
        UC06 [label="UC06\nKý quỹ ETH\n(Deposit)"];
        UC07 [label="UC07\nChuyển quyền sở hữu\nSafe"];
        UC08 [label="UC08\nGiải ngân ký quỹ\n(Release)"];
        UC09 [label="UC09\nYêu cầu hủy / hoàn tiền\n(Cancel / Refund)"];
        UC10 [label="UC10\nTra cứu trạng thái\ngiao dịch"];
        UC11 [label="UC11\nTheo dõi cảnh báo\nnonce bất thường"];
        UC12 [label="UC12\nQuản lý phiên\nhội thoại"];

        UC06 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC05 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC07 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC08 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC04 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC09 -> UC03 [label="«include»", style=dashed, arrowhead=vee, color="#555555"];
        UC10 -> UC11 [label="«extend»", style=dashed, arrowhead=vee, color="#555555"];
    }

    Guest -> UC01;
    Guest -> UC02;
    Guest -> UC12;

    Buyer -> UC01;
    Buyer -> UC02;
    Buyer -> UC06;
    Buyer -> UC08;
    Buyer -> UC09;
    Buyer -> UC10;
    Buyer -> UC11;
    Buyer -> UC12;

    Seller -> UC01;
    Seller -> UC02;
    Seller -> UC04;
    Seller -> UC05;
    Seller -> UC07;
    Seller -> UC09;
    Seller -> UC10;
    Seller -> UC11;
    Seller -> UC12;

    UC01 -> LLM     [dir=both, style=dotted];
    UC02 -> LLM     [dir=both, style=dotted];
    UC10 -> SafeAPI [dir=both, style=dotted];
    UC10 -> Chain   [dir=both, style=dotted];
    UC11 -> Watcher [dir=both, style=dotted];
    UC11 -> Chain   [dir=both, style=dotted];
    UC04 -> SafeAPI [dir=both, style=dotted];
    UC05 -> Chain   [dir=both, style=dotted];
    UC06 -> Chain   [dir=both, style=dotted];
    UC07 -> Chain   [dir=both, style=dotted];
    UC08 -> Chain   [dir=both, style=dotted];
    UC09 -> SafeAPI [dir=both, style=dotted];
}
