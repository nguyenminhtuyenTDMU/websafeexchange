digraph UCPhanRaArm {
    rankdir=LR;
    fontname="Times New Roman";
    node [fontname="Times New Roman"];
    edge [fontname="Times New Roman", fontsize=10];
    labelloc="t";
    label="Phân rã Use Case UC05 – Kích hoạt trade (Arm)";
    fontsize=14;

    node [shape=none];
    Seller [label=<<table border="0"><tr><td><font point-size="40">👤</font></td></tr><tr><td><b>Seller</b></td></tr></table>>];

    subgraph cluster_sys {
        label="Chatbot Langflow – Arming Flow";
        style=rounded;
        bgcolor="#F5F9FF";
        color="#2E75B6";
        penwidth=2;

        node [shape=ellipse, style=filled, fillcolor="#D5E8F0", color="#2E75B6"];

        UC05 [label="UC05\nKích hoạt trade"];
        A1 [label="UC05.1\nXác minh quyền sở hữu\nSafe (isOwner)"];
        A2 [label="UC05.2\nChụp nonce snapshot\ncủa Safe hiện tại"];
        A3 [label="UC05.3\nHướng dẫn gọi hàm\narmTrade() on-chain"];
        A4 [label="UC05.4\nLưu snapshot\nvào off-chain DB"];
        A5 [label="UC05.5\nCập nhật trạng thái\nLISTED → ARMED"];

        UC03 [label="UC03\nKết nối ví", fillcolor="#FFE699"];
        E1 [label="UC-EX4\nKhông phải\nowner của Safe", fillcolor="#F8CBAD"];
        E2 [label="UC-EX5\nNonce thay đổi\ngiữa lúc verify\n& lúc ký", fillcolor="#F8CBAD"];

        UC05 -> UC03 [label="«include»", style=dashed, arrowhead=vee];
        UC05 -> A1 [label="«include»", style=dashed, arrowhead=vee];
        UC05 -> A2 [label="«include»", style=dashed, arrowhead=vee];
        UC05 -> A3 [label="«include»", style=dashed, arrowhead=vee];
        UC05 -> A4 [label="«include»", style=dashed, arrowhead=vee];
        UC05 -> A5 [label="«include»", style=dashed, arrowhead=vee];

        E1 -> A1 [label="«extend»", style=dashed, arrowhead=vee];
        E2 -> A3 [label="«extend»", style=dashed, arrowhead=vee];
    }

    Seller -> UC05;
}
