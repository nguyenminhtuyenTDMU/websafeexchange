digraph UCPhanRaDeposit {
    rankdir=LR;
    fontname="Times New Roman";
    node [fontname="Times New Roman"];
    edge [fontname="Times New Roman", fontsize=10];
    labelloc="t";
    label="Phân rã Use Case UC06 – Ký quỹ ETH (Deposit)";
    fontsize=14;

    node [shape=none];
    Buyer [label=<<table border="0"><tr><td><font point-size="40">👤</font></td></tr><tr><td><b>Buyer</b></td></tr></table>>];

    subgraph cluster_sys {
        label="Chatbot Langflow – Deposit Flow";
        style=rounded;
        bgcolor="#F5F9FF";
        color="#2E75B6";
        penwidth=2;

        node [shape=ellipse, style=filled, fillcolor="#D5E8F0", color="#2E75B6"];

        UC06   [label="UC06\nKý quỹ ETH"];
        S1 [label="UC06.1\nKiểm tra trade\nstatus = ARMED"];
        S2 [label="UC06.2\nHiển thị số ETH\ncần ký quỹ & phí"];
        S3 [label="UC06.3\nHướng dẫn gọi hàm\ndeposit() on-chain"];
        S4 [label="UC06.4\nGhi nhận txHash\n(off-chain)"];
        S5 [label="UC06.5\nTheo dõi block\nconfirmation"];
        S6 [label="UC06.6\nCập nhật trạng thái\n→ FUNDED"];

        UC03 [label="UC03\nKết nối ví", fillcolor="#FFE699"];
        E1 [label="UC-EX1\nGas không đủ", fillcolor="#F8CBAD"];
        E2 [label="UC-EX2\nTransaction\nrevert", fillcolor="#F8CBAD"];
        E3 [label="UC-EX3\nTrade bị\nCANCELLED", fillcolor="#F8CBAD"];

        UC06 -> UC03 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S1 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S2 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S3 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S4 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S5 [label="«include»", style=dashed, arrowhead=vee];
        UC06 -> S6 [label="«include»", style=dashed, arrowhead=vee];

        E1 -> S3 [label="«extend»", style=dashed, arrowhead=vee];
        E2 -> S5 [label="«extend»", style=dashed, arrowhead=vee];
        E3 -> S1 [label="«extend»", style=dashed, arrowhead=vee];
    }

    Buyer -> UC06;
}
